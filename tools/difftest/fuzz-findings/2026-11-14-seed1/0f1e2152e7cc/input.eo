

(declare-const or (-> Bool Bool Bool) :right-assoc-nil false)(program substitute-over-or ((x Bool) (y Bool) (l Bool :list) (z Bool))
  :signature (Bool Bool Bool) Bool
  (
  ((substitute-over-or x y (or z l))  (_ or (substitute-over-or x y ) (substitute-over-or x y l)))
  
  
  )
)

(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(declare-const test1 (eo::requires (substitute-over-or c b (or a b c))